# Database: local MySQL is the recommended configuration for this build.
CIVICCARE_DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=civiccare

# SQLite fallback:
# CIVICCARE_DB_ENGINE=sqlite
# CIVICCARE_DB_PATH=data/civiccare.db

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CIVICCARE_JWT_SECRET=PASTE_A_LONG_RANDOM_SECRET_HERE

# Optional TomTom live traffic/incidents provider
TOMTOM_API_KEY=PASTE_YOUR_TOMTOM_KEY_HERE

OVERPASS_URL=https://overpass-api.de/api/interpreter
CIVICCARE_HTTP_TIMEOUT=8
CIVICCARE_LIVE_CACHE_TTL=60
CIVICCARE_UPLOADS_DIR=uploads
